<?xml version="1.0" encoding="utf-8"?>
<!-- SurfaceView (varsayılan): TV işlemcisini en az yoran çizim yolu.
     Siyah perde ilk gerçek kare gelene kadar video katmanını örter (bazı TV çözücüleri o ana kadar bozuk şerit gösterir). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    app:use_controller="false"
    app:show_buffering="never"
    app:resize_mode="fit"
    app:keep_content_on_player_reset="false"
    app:shutter_background_color="#000000" />
