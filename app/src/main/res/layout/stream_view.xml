<?xml version="1.0" encoding="utf-8"?>
<!-- TextureView: video uygulamanın kendi penceresinde çizilir. (SurfaceView ayrı bir donanım katmanında
     çizildiği için bazı TV'lerde kanal geçişinde sol üst köşede eski görüntü sızıyordu.) -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:show_buffering="never"
    app:resize_mode="fit"
    app:keep_content_on_player_reset="false"
    app:shutter_background_color="#000000" />
